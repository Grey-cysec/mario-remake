            pygame.draw.rect(s, (230, 70, 70), (5, 22, 6, 2))
            s = pygame.transform.rotate(s, deg)
            _ARROW_ROT[deg] = s
        screen.blit(s, s.get_rect(center=(int(a["x"] - cam), int(a["y"]))))
