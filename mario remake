def present():
    """Scale the 800x450 canvas to the borderless window; GPU post-processing when available."""
    if not GL["ok"]:
        s = min(WIN_W / W, WIN_H / H)
        dw, dh = int(W * s), int(H * s)
        window.fill((0, 0, 0))
        window.blit(pygame.transform.scale(screen, (dw, dh)), ((WIN_W - dw) // 2, (WIN_H - dh) // 2))
        pygame.display.flip()
        return
    GL["tex"].write(pygame.image.tobytes(screen, "RGB"))
    # 1) bright pass, downsampled to quarter res
    GL["fbo_a"].use()
    GL["prog_bright"]["u_tex"].value = 0
    GL["prog_bright"]["u_threshold"].value = SH["threshold"]
    GL["tex"].use(0)
    GL["vao_bright"].render(moderngl.TRIANGLE_STRIP)
    # 2) separable blur, ping-pong a -> b -> a
    p = GL["prog_blur"]
    p["u_tex"].value = 0
    GL["fbo_b"].use()
    GL["fbo_a"].color_attachments[0].use(0)
    p["u_dir"].value = (1.0 / GL["qw"], 0.0)
    GL["vao_blur"].render(moderngl.TRIANGLE_STRIP)
    GL["fbo_a"].use()
    GL["fbo_b"].color_attachments[0].use(0)
    p["u_dir"].value = (0.0, 1.0 / GL["qh"])
    GL["vao_blur"].render(moderngl.TRIANGLE_STRIP)
    # 3) final composite: grade + bloom + vignette
    GL["ctx"].screen.use()
    p = GL["prog_final"]
    p["u_tex"].value = 0
    p["u_bloom_tex"].value = 1
    p["u_scale"].value = GL["scale"]
    p["u_bloom"].value = SH["bloom"]
    p["u_sat"].value = SH["sat"]
    p["u_contrast"].value = SH["contrast"]
    p["u_vig"].value = SH["vig"]
    p["u_time"].value = t_now
    GL["tex"].use(0)
    GL["fbo_a"].color_attachments[0].use(1)
    GL["vao_final"].render(moderngl.TRIANGLE_STRIP)
    pygame.display.flip()


# ---------------- main loop ----------------
def main():
    make_level(0)
    while True:
        dt = min(1 / 30, clock.tick(60) / 1000)
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT or (ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE):
                pygame.quit()
                sys.exit()
            if ev.type == pygame.KEYDOWN and ev.key == pygame.K_RETURN and state in ("title", "over"):
                start_game()
            if ev.type == pygame.KEYDOWN and ev.key == pygame.K_F1:
                DBG["open"] = not DBG["open"]
        update(dt)
        draw()
        if shake > 0:  # camera shake must happen before the frame is presented
            snap = screen.copy()
            screen.fill((0, 0, 0))
            screen.blit(snap, (random.randint(-5, 5), random.randint(-5, 5)))
        present()
        fps_hist.append(clock.get_fps())
        del fps_hist[:-140]


if __name__ == "__main__":
    main()