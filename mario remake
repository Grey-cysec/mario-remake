def kill_player(force=False):
    if DBG["god"] or P.dead or (P.inv > 0 and not force):
        return
    global shake, flash
    shake = 0.4
    flash = 0.3
    P.dead, P.dT, P.vy, P.vx = True, 0.0, -480.0, 0.0
    burst(P.x + 11, P.y + 14, (230, 50, 50), 24, 260)


def shoot():
    if P.cd > 0 or P.dead:
        return
    P.cd = 0.35
    for off in ((-160.0, -40.0, 80.0) if P.multi > 0 else (-40.0,)):
        arrows.append({"x": P.x + 11 + P.face * 12, "y": P.y + 12, "vx": P.face * 480.0, "vy": off, "life": 0.7, "a": 0.0})


def boss_alive():
    return any(e.t == "X" and not e.dead for e in enemies)


def safe_ahead(e, d):
    """True if the tile in front of a walker has floor, no wall and no spike."""
    lead = int((e.x + (e.w + 6 if d > 0 else -6)) // T)
    row = int((e.y + e.h - 2) // T)
    floor_t = int((e.y + e.h + 4) // T)
    if lead < 0 or lead >= cols or not (0 <= row < ROWS):
        return False
    return solid(lead, floor_t) and not solid(lead, row) and grid[row][lead] != 3


def revive(e):
    e.x, e.y, e.vx, e.vy = e.sx, e.sy, e.svx, 0.0
    e.dead, e.dT = False, 0.0
    if e.t == "X":
        e.hp, e.tm, e.fire, e.flash = e.maxhp, 0.0, 2.0, 0.0


def hurt(e):
    global score
    cx, cy = e.x + e.w / 2, e.y + e.h / 2
    if e.t == "X":
        e.hp -= 1
        e.flash = 0.15
        burst(cx, cy, (255, 120, 40), 8)
        if e.hp > 0:
            return
        score += 500
        burst(cx, cy, (255, 200, 60), 50, 380)
    else:
        score += 30
        burst(cx, cy, (140, 80, 200) if e.t == "b" else (170, 80, 30), 14)
    e.dead = True


def nearest_enemy(a):
    best, bd = None, 1e18
    for e in enemies:
        if e.dead:
            continue
        dx, dy = e.x + e.w / 2 - a["x"], e.y + e.h / 2 - a["y"]
        d = dx * dx + dy * dy
        if d < bd and abs(dx) < 330 and abs(dy) < 220:
            best, bd = e, d
    return best


def start_game():
    global state, lvl, lives, score, banner, banner_txt
    lvl, lives, score = 0, 3, 0
    make_level(0)
    state, banner, banner_txt = "play", 2.0, None


# ---------------- update ----------------
def update(dt):
    global state, lives, score, lvl, cam, banner, banner_txt, cp, arrows, parts, t_now, fireballs, shake, flash
    t_now += dt
    if state != "play":
        return
    banner = max(0.0, banner - dt)
    flash = max(0.0, flash - dt)
    P.squash = 0.0 if abs(P.squash) < 0.01 else P.squash * max(0.0, 1 - dt * 6)
    P.cd = max(0.0, P.cd - dt)
    P.inv = max(0.0, P.inv - dt)
    P.multi = max(0.0, P.multi - dt)
    k = pygame.key.get_pressed()

    if P.dead:
        P.dT += dt
        P.vy += 1400 * dt
        P.y += P.vy * dt
        if P.dT > 1.5:
            lives -= 1
            if lives <= 0:
                state = "over"
            else:
                reset_player(cp)
                P.inv, P.multi = 2.0, 0.0
                arrows, fireballs = [], []
                score = lvl_score
                for e in enemies:
                    revive(e)
                for c in coins + powers:
                    c["got"] = False
    else:
        left = k[pygame.K_LEFT] or k[pygame.K_a]
        right = k[pygame.K_RIGHT] or k[pygame.K_d]
        jump = k[pygame.K_SPACE] or k[pygame.K_UP] or k[pygame.K_w]
        acc = 1800 if P.ground else 1100
        if left and not right:
            P.vx = max(-TUNE["max_spd"], P.vx - acc * dt)
            P.face = -1
        elif right and not left:
            P.vx = min(TUNE["max_spd"], P.vx + acc * dt)
            P.face = 1
        else:
            f = (1600 if P.ground else 300) * dt
            P.vx = 0 if abs(P.vx) < f else P.vx - math.copysign(f, P.vx)
        P.coyote -= dt
        P.buf -= dt
        if jump and not P.jheld:
            P.buf = 0.12
        P.jheld = bool(jump)
        if P.ground:
            P.coyote, P.air = 0.1, 1
        if P.buf > 0 and P.coyote > 0:
            P.vy, P.coyote, P.buf, P.ground, P.cut = TUNE["jump"], 0.0, 0.0, False, False
            P.squash = -0.25
        elif P.buf > 0 and P.air > 0 and not P.ground:
            P.vy, P.air, P.buf, P.cut = TUNE["jump2"], P.air - 1, 0.0, False
            P.squash = -0.25
            burst(P.x + 11, P.y + P.h, (255, 255, 255), 10, 140)
        if not jump and P.vy < -260 and not P.cut:
            P.vy *= 0.45
            P.cut = True
        P.vy = min(900.0, P.vy + TUNE["grav"] * dt)
        move_x(P, dt)
        fall = P.vy
        P.ground = move_y(P, dt)
        if P.ground and fall > 420:  # landing squash + dust puff
            P.squash = 0.35
            burst(P.x + 11, P.y + P.h, (215, 200, 170), 8, 90)
        if k[pygame.K_f]:
            shoot()
        # spikes
        ty = int((P.y + P.h - 1) // T)
        for x in range(int((P.x + 5) // T), int((P.x + P.w - 6) // T) + 1):
            if 0 <= ty < ROWS and 0 <= x < cols and grid[ty][x] == 3 and P.y + P.h > ty * T + 18:
                kill_player()
        if P.y > H + 80:
            kill_player(True)
        for c in coins:
            if not c["got"] and P.x < c["x"] + 18 and P.x + P.w > c["x"] - 4 and P.y < c["y"] + 22 and P.y + P.h > c["y"] - 4:
                c["got"] = True
                score += 10
                burst(c["x"] + 7, c["y"] + 9, (255, 215, 0), 6, 120)
        for pw in powers:
            if not pw["got"] and abs(P.x + 11 - pw["x"] - 10) < 22 and abs(P.y + 14 - pw["y"] - 10) < 26:
                pw["got"] = True
                score += 50
                if pw.get("k") == "heart":
                    lives += 1
                    banner, banner_txt = 1.2, "+1 LIFE"
                    burst(P.x + 11, P.y, (255, 90, 120), 20, 250)
                else:
                    P.multi = 12.0
        if boss_alive() and P.x > flag_x - 10:
            P.x, P.vx = flag_x - 10, 0.0
        for c in cps:
            if not c["on"] and P.x + P.w > c["x"]:
                c["on"] = True
                cp = (c["x"] - 6, 13 * T - P.h)
                banner, banner_txt = 1.6, "CHECKPOINT"
                burst(c["x"] + 14, 12 * T, (80, 255, 120), 30, 300)
        if P.x > flag_x and not boss_alive():
            lvl += 1
            score += 100
            make_level(lvl)
            banner, banner_txt = 2.0, None
            flash = 0.25

    # enemies
    for e in enemies:
        if e.dead:
            e.dT += dt
            if e.y <= H + 200:  # stop accelerating once the body is off-screen
                e.vy += 1200 * dt
                e.y += e.vy * dt
            if e.t != "X" and e.dT > 20 and abs(e.sx - P.x) > 700:
                revive(e)
            continue
        if e.t == "w":
            sp = abs(e.svx) + 12
            dx = P.x - e.x
            d = 0 if (P.dead or abs(dx) > 800 or abs(dx) < 10) else (1 if dx > 0 else -1)
            e.vy = min(800.0, e.vy + 1500 * dt)
            e.vx = d * sp if (d and safe_ahead(e, d)) else 0.0
            move_x(e, dt)
            move_y(e, dt)
        elif e.t == "b":
            e.ph += dt * 2.5
            dx, dy = P.x + 11 - e.x, P.y + math.sin(e.ph) * 26 - e.y
            dist = math.hypot(dx, dy) or 1.0
            if not P.dead and dist < 800:
                sp = 85 + 8 * lvl
                nx, ny = e.x + dx / dist * sp * dt, e.y + dy / dist * sp * dt
                if solid(int((nx + 13) // T), int((ny + 10) // T)):
                    nx, ny = e.x, e.y - 90 * dt
                e.x, e.y = nx, min(ny, 12 * T - 24)
            else:
                e.y += math.sin(e.ph) * 20 * dt
        else:
            if abs(P.x - e.x) > 700:
                continue
            e.tm += dt
            e.flash = max(0.0, e.flash - dt)
            d = 1 if P.x > e.x else -1
            e.vx = d * (70 + 6 * lvl)
            e.vy = min(800.0, e.vy + 1500 * dt)
            move_x(e, dt)
            on = move_y(e, dt)
            e.x = max((cols - 22) * T, min(e.x, (cols - 3) * T - e.w))
            if on and e.tm > 2.2:
                e.vy, e.tm = -620.0, 0.0
            e.fire -= dt
            if e.fire <= 0:
                e.fire = max(0.8, 1.7 - 0.1 * lvl)
                fireballs.append({"x": e.x + e.w / 2, "y": e.y + e.h - 22, "vx": d * 280.0, "vy": 0.0, "life": 4.0})
        if not P.dead and overlap(P, e):
            if e.t in ("w", "X") and P.vy > 80 and P.y + P.h - e.y < 18:
                hurt(e)
                P.vy = -380.0
                P.inv = max(P.inv, 0.4)
            else:
                kill_player()

    for fb in fireballs:
        fb["life"] -= dt
        fb["x"] += fb["vx"] * dt
        fb["y"] += fb["vy"] * dt
        if random.random() < 0.5:  # fiery trail
            parts.append([fb["x"], fb["y"], random.uniform(-30, 30), -20, 0.35, (255, 150, 40)])
        if solid(int(fb["x"] // T), int(fb["y"] // T)):
            fb["life"] = 0
        if not P.dead and abs(fb["x"] - (P.x + 11)) < 14 and abs(fb["y"] - (P.y + 14)) < 18:
            fb["life"] = 0
            kill_player()
    fireballs = [f for f in fireballs if f["life"] > 0]
    shake = max(0.0, shake - dt)

    # self-aiming arrows
    for a in arrows:
        a["life"] -= dt
        ang = math.atan2(a["vy"], a["vx"])
        tgt = nearest_enemy(a)
        if tgt:
            want = math.atan2(tgt.y + tgt.h / 2 - a["y"], tgt.x + tgt.w / 2 - a["x"])
            d = (want - ang + math.pi) % (2 * math.pi) - math.pi
            turn = TUNE["turn"] * dt
            ang += max(-turn, min(turn, d))
        a["vx"], a["vy"], a["a"] = math.cos(ang) * TUNE["arrow_spd"], math.sin(ang) * TUNE["arrow_spd"], ang
        px, py = a["x"], a["y"]  # previous position: stops arrows tunneling past small enemies on laggy frames
        a["x"] += a["vx"] * dt
        a["y"] += a["vy"] * dt
        parts.append([a["x"], a["y"], 0, 0, 0.2, (255, 210, 74)])
        if solid(int(a["x"] // T), int(a["y"] // T)):
            a["life"] = 0
        for e in enemies:
            if e.dead:
                continue
            if (e.x < a["x"] < e.x + e.w and e.y < a["y"] < e.y + e.h) or \
               (e.x < px < e.x + e.w and e.y < py < e.y + e.h):
                a["life"] = 0
                hurt(e)
    arrows = [a for a in arrows if a["life"] > 0]
    for p in parts:
        p[4] -= dt
        p[0] += p[2] * dt
        p[1] += p[3] * dt
        p[3] += 500 * dt
    parts = [p for p in parts if p[4] > 0]
    for q in pollen:  # ambient drifting pollen
        q["x"] -= (10 + 14 * q["s"]) * dt
        if q["x"] < -6:
            q["x"], q["y"] = W + 6, random.uniform(40, H - 60)
    target = max(0, min(cols * T - W, P.x - W * 0.4))
    cam += (target - cam) * min(1.0, dt * 8)


# ---------------- drawing ----------------
def text(s, font, x, y, col=(255, 255, 255), align="left"):
    key = (s, font, col)
    img = _TEXT_CACHE.get(key)
    if img is None:  # shadow + fill composited once, then reused every frame
        if len(_TEXT_CACHE) > 400:
            _TEXT_CACHE.clear()
        fill = font.render(s, True, col)
        img = pygame.Surface((fill.get_width() + 2, fill.get_height() + 2), pygame.SRCALPHA)
        img.blit(font.render(s, True, (0, 0, 0)), (2, 2))
        img.blit(fill, (0, 0))
        _TEXT_CACHE[key] = img
    tw = img.get_width() - 2
    rx = x - tw // 2 if align == "center" else x - tw if align == "right" else x
    screen.blit(img, (rx, y))


def parallax_blit(surf, factor, y):
    w = surf.get_width()
    off = int(cam * factor) % w
    for x in range(-off - w, W + w, w):
        screen.blit(surf, (x, y))


def draw_bg():
    global _BG_GRAD
    if _BG_GRAD is None:  # the sky gradient never changes: render it once
        _BG_GRAD = pygame.Surface((W, H))
        for y in range(0, H, 5):
            t = y / H
            pygame.draw.rect(_BG_GRAD, (int(66 + 90 * t), int(130 + 70 * t), int(205 + 40 * t)), (0, y, W, 5))
    screen.blit(_BG_GRAD, (0, 0))
    screen.blit(radial(60, (255, 236, 165), 105), (680 - 60, 80 - 60))
    pygame.draw.circle(screen, (255, 240, 190), (680, 80), 36)
    pygame.draw.circle(screen, (255, 248, 224), (672, 72), 22)
    parallax_blit(LAYERS["far"], 0.06, 60)
    parallax_blit(LAYERS["mtn"], 0.12, 20)
    parallax_blit(LAYERS["cloud"], 0.10, 26)
    parallax_blit(LAYERS["hill"], 0.25, 260)


def draw_tiles():
    x0 = int(cam // T)
    for y in range(ROWS):
        for x in range(x0, min(cols, x0 + W // T + 2)):
            v = grid[y][x]
            if not v:
                continue
            exposed = v == 1 and (y == 0 or grid[y - 1][x] != 1)
            screen.blit(tile_img(v, exposed, (x * 7 + y * 13) % 3), (x * T - int(cam), y * T))
    fx = int(flag_x - cam)
    pygame.draw.rect(screen, (200, 200, 210), (fx, 6 * T, 5, 7 * T))
    pygame.draw.rect(screen, (250, 250, 255), (fx, 6 * T, 2, 7 * T))
    pygame.draw.circle(screen, (255, 214, 70), (fx + 2, 6 * T - 2), 5)
    for i in range(4):  # waving flag
        yo = int(math.sin(t_now * 6 + i * 0.9) * 3)
        rx = fx + 44 - abs(i - 1.5) * 4
        pygame.draw.polygon(screen, (226 - i * 8, 34, 34),
                            [(fx + 5, 6 * T + i * 8), (int(rx), 6 * T + 12 + i * 8 + yo), (fx + 5, 6 * T + (i + 1) * 8)])


def draw_boss(e, x, y):
    frames = ART["boss_shoot" if e.fire < 0.4 else "boss_idle"]
    f, w = frames[int(t_now * 3) % len(frames)]
    if e.flash > 0:
        f = w
    screen.blit(f, (x - 7, y + e.h - 78))


def draw_enemies():
    for e in enemies:
        if e.dead and e.dT > 1:
            continue
        x, y = int(e.x - cam), int(e.y)
        if x < -80 or x > W + 80:  # cull off-screen enemies
            continue
        if e.t == "X":
            draw_boss(e, x, y)
            continue
        if e.t == "w":
            screen.blit(ART["walker"][int(t_now * 8 + e.x * 0.07) % 4][0], (x - 2, y - 4))
        else:
            screen.blit(ART["bat"][int(t_now * 12 + e.ph * 3) % 4][0], (x - 7, y - 6))


def draw_player():
    if P.inv > 0 and not P.dead and int(t_now * 14) % 2:
        return
    if P.ground and abs(P.vx) > 10:
        frames, idx = ART["hero_run"], int(t_now * 14) % 6
    elif P.ground:
        frames, idx = ART["hero_idle"], int(t_now * 1.6) % 3
    elif P.vy < 0:
        frames, idx = ART["hero_jump"], 0
    else:
        frames, idx = ART["hero_fall"], 0
    surf = frames[idx][0]
    if abs(P.squash) > 0.01:  # stretch on jump, squash on landing
        k = 1 + P.squash * 0.9
        surf = pygame.transform.scale(surf, (max(1, int(76 * k)), max(1, int(76 * (2 - k)))))
    if P.face < 0:
        surf = pygame.transform.flip(surf, True, False)
    if P.dead:
        surf = pygame.transform.rotate(surf, -P.dT * 460)
    screen.blit(surf, surf.get_rect(center=(int(P.x - cam + 11), int(P.y - 3))))


