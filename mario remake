def make_level(n):
    global grid, cols, enemies, coins, arrows, parts, flag_x, cp, powers, fireballs, cps, lvl_score
    r = random.Random(n * 97 + 13)
    cols = 110 + n * 16
    grid = [[0] * cols for _ in range(ROWS)]
    enemies, coins, arrows, parts = [], [], [], []
    powers, fireballs, cps = [], [], []
    cp = None

    def put(x, y, v):
        if 0 <= x < cols and 0 <= y < ROWS:
            grid[y][x] = v

    def ground(a, b):
        for x in range(a, b):
            put(x, 13, 1)
            put(x, 14, 1)

    ground(0, 18)
    x = 18
    while x < cols - 24:
        gap = r.randint(2, 3 if n == 0 else 4)
        ln = r.randint(8, 19)
        a, b = x + gap, min(x + gap + ln, cols - 22)
        ln = b - a
        for i in range(gap):
            coins.append({"x": (x + i) * T + 8, "y": 9 * T + 14, "got": False})
        ground(a, b)
        plat = (-9, -9)
        if ln >= 9 and r.random() < 0.85:
            px, row = a + 2, 10
            plat = (px, px)
            for k in range(r.randint(3, 4 + min(n, 2))):
                pl = r.randint(2, 3)
                if px + pl > b - 1:
                    break
                for i in range(pl):
                    put(px + i, row, 2)
                    coins.append({"x": (px + i) * T + 8, "y": (row - 1) * T + 6, "got": False})
                plat = (plat[0], px + pl)
                if k == 2 and r.random() < 0.6:
                    powers.append({"x": px * T + 4, "y": (row - 1) * T, "k": "heart" if r.random() < 0.3 else "star", "got": False})
                px += pl + r.randint(1, 2)
                row = max(8, min(10, row + r.choice((-2, -1, 1, 2))))
        if ln >= 10 and r.random() < 0.2 + n * 0.12:
            for _try in range(6):
                sx = a + 4 + r.randint(0, ln - 8)
                if sx + 1 < plat[0] - 1 or sx > plat[1] + 1:
                    put(sx, 12, 3)
                    if r.random() < 0.5:
                        put(sx + 1, 12, 3)
                    break
        for _ in range(r.randint(1, 2 + min(n, 2))):
            e = Body((a + 3 + r.random() * max(1, ln - 5)) * T, 12 * T, 24, 24)
            e.t, e.vx = "w", r.choice((-1, 1)) * (45 + n * 10)
            e.dead, e.dT = False, 0.0
            enemies.append(e)
        if r.random() < 0.5 + n * 0.1:
            by = (5 + r.random() * 4) * T
            bx = (a + r.random() * ln) * T
            # keep bats out of brick platforms: retry higher air until the cell is clear
            for _try in range(10):
                if not any(solid(cx, cy)
                           for cy in range(int(by // T), int((by + 19) // T) + 1)
                           for cx in range(int(bx // T), int((bx + 25) // T) + 1)):
                    break
                by, bx = (3 + r.random() * 2) * T, (a + r.random() * ln) * T
            else:
                by, bx = 3 * T, (a + ln / 2) * T
            e = Body(bx, by, 26, 20)
            e.t, e.base, e.ph, e.dead, e.dT = "b", by, r.random() * 6, False, 0.0
            enemies.append(e)
        x = b
    ground(cols - 22, cols)
    flag_x = (cols - 5) * T
    boss = Body((cols - 12) * T, 9 * T, 56, 60)
    boss.t, boss.hp, boss.maxhp, boss.tm, boss.fire = "X", 8 + 3 * n, 8 + 3 * n, 0.0, 2.0
    boss.flash, boss.dead, boss.dT = 0.0, False, 0.0
    enemies.append(boss)
    for e in enemies:
        e.sx, e.sy, e.svx = e.x, e.y, e.vx
    def clear_spot(cx):
        return (0 < cx < cols - 2 and grid[13][cx] == 1 and grid[13][cx + 1] == 1 and
                all(grid[y][cx + k] == 0 for y in (9, 10, 11, 12) for k in (-1, 0, 1, 2)))

    for frac in (0.38, 0.68):
        x, spot = int(cols * frac), None
        while x < cols - 26:
            if clear_spot(x):
                spot = x
                break
            x += 1
        if spot is None:  # nothing ahead: fall back to the nearest safe ground behind it
            for cx in range(min(int(cols * frac), cols - 27), 1, -1):
                if clear_spot(cx):
                    spot = cx
                    break
        cps.append({"x": (spot if spot is not None else 2) * T, "on": False})
    lvl_score = score
    reset_player()
    P.inv = 1.0


def safe_footing(px):
    """Column with solid ground under the spawn height, nearest to px (never a pit)."""
    tx = int((px + P.w // 2) // T)
    for d in (0, -1, 1, -2, 2, -3, 3):
        if 0 <= tx + d < cols and grid[13][tx + d] == 1:
            return (tx + d) * T + T // 2 - P.w // 2
    return 2 * T


def reset_player(at=None):
    P.x, P.y = at if at else (2 * T, 12 * T - P.h)
    if at:  # safety net: a checkpoint must never dump the player into a pit
        P.x = safe_footing(P.x)
    P.vx = P.vy = 0.0
    P.dead = False
    P.cd = 0.0
    P.squash = 0.0


def solid(tx, ty):
    if tx < 0 or tx >= cols:
        return True
    if ty < 0 or ty >= ROWS:
        return False
    return grid[ty][tx] in (1, 2)


def tile_range(e):
    return (int(e.x // T), int((e.x + e.w - 1) // T), int(e.y // T), int((e.y + e.h - 1) // T))


def move_x(e, dt):
    dx = e.vx * dt
    steps = int(abs(dx) // 8) + 1
    hit = False
    for _ in range(steps):
        e.x += dx / steps
        x0, x1, y0, y1 = tile_range(e)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if solid(x, y):
                    if dx > 0:
                        e.x = x * T - e.w
                    elif dx < 0:
                        e.x = (x + 1) * T
                    hit = True
        if hit:
            e.vx = 0.0
            break
    return hit


def move_y(e, dt):
    dy = e.vy * dt
    steps = int(abs(dy) // 8) + 1
    on = False
    for _ in range(steps):
        e.y += dy / steps
        x0, x1, y0, y1 = tile_range(e)
        hit = False
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if solid(x, y):
                    if dy > 0:
                        e.y, on = y * T - e.h, True
                    elif dy < 0:
                        e.y = (y + 1) * T
                    hit = True
        if hit:
            e.vy = 0.0
            break
    return on


def overlap(a, b):
    return a.x < b.x + b.w and a.x + a.w > b.x and a.y < b.y + b.h and a.y + a.h > b.y


def burst(x, y, col, n=12, sp=200):
    for _ in range(n):
        a, s = random.random() * 6.28, random.random() * sp
        parts.append([x, y, math.cos(a) * s, math.sin(a) * s - 80, 0.6 + random.random() * 0.4, col])


def radial(radius, col, peak):
    """Soft radial-gradient blob, cached - used for glows and the sun halo."""
    key = (radius, col, peak)
    g = radial.cache.get(key)
    if g is None:
        g = pygame.Surface((radius * 2, radius * 2), pygame.SRCALPHA)
        for r in range(radius, 0, -1):
            pygame.draw.circle(g, (*col, int(peak * (1 - r / radius) ** 1.6)), (radius, radius), r)
        radial.cache[key] = g
    return g
radial.cache = {}


