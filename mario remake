        deg = int(round(-math.degrees(a["a"]))) % 360  # normalised so the cache never overflows
        s = _ARROW_ROT.get(deg)
        if s is None:  # the sprite only depends on its angle: cache each rotation once
            s = pygame.Surface((40, 40), pygame.SRCALPHA)
            pygame.draw.rect(s, (220, 220, 220), (6, 18, 22, 3))
            pygame.draw.polygon(s, (255, 210, 74), [(28, 14), (36, 20), (28, 26)])
