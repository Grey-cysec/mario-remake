def _limb(s, x1, y1, x2, y2, wdt, col):
    dx, dy = x2 - x1, y2 - y1
    ln = max(1.0, math.hypot(dx, dy))
    nx, ny = -dy / ln * wdt / 2, dx / ln * wdt / 2
    pygame.draw.polygon(s, col, [(x1 + nx, y1 + ny), (x2 + nx, y2 + ny), (x2 - nx, y2 - ny), (x1 - nx, y1 - ny)])
    pygame.draw.circle(s, col, (int(x1), int(y1)), int(wdt / 2))
    pygame.draw.circle(s, col, (int(x2), int(y2)), int(wdt / 2))


