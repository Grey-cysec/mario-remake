    pygame.draw.rect(UI["s"], (90, 160, 255), (0, 0, w, h), 1, border_radius=8)
    pygame.draw.rect(UI["s"], (40, 48, 62), (1, 1, w - 2, 24))
    UI["s"].blit(UI_F.render(title, True, (150, 200, 255)), (10, 5))


def ui_end():
    screen.blit(UI["s"], (UI["x"], UI["y"]))


def ui_label(s, col=(205, 210, 220)):
    t = UI_F.render(s, True, col)
    UI["s"].blit(t, (UI["cx"] - UI["x"], UI["cy"] - UI["y"]))
    UI["cy"] += t.get_height() + 3


def ui_sep():
    pygame.draw.line(UI["s"], (70, 80, 95), (8, UI["cy"] - UI["y"]), (UI["w"] - 8, UI["cy"] - UI["y"]))
    UI["cy"] += 7


def ui_check(label, val):
    bx, by = UI["cx"] - UI["x"], UI["cy"] - UI["y"]
    box = pygame.Rect(bx, by + 2, 14, 14)
    hover = box.move(UI["x"], UI["y"]).collidepoint(UI["mx"], UI["my"])
    pygame.draw.rect(UI["s"], (80, 95, 120) if hover else (55, 64, 82), box, border_radius=3)
    if val:
        pygame.draw.rect(UI["s"], (120, 220, 140), box.inflate(-6, -6), border_radius=2)
    UI["s"].blit(UI_F.render(label, True, (230, 233, 240) if hover else (200, 205, 215)), (bx + 20, by))
    UI["cy"] += 19
    return hover and UI["click"]


def ui_button(label, w=88, dx=0):
    bx, by = UI["cx"] - UI["x"] + dx, UI["cy"] - UI["y"]
    r = pygame.Rect(bx, by, w, 18)
    hover = r.move(UI["x"], UI["y"]).collidepoint(UI["mx"], UI["my"])
    pygame.draw.rect(UI["s"], (58, 70, 92) if hover else (40, 47, 60), r, border_radius=4)
    pygame.draw.rect(UI["s"], (90, 105, 130), r, 1, border_radius=4)
    t = UI_F.render(label, True, (232, 236, 244))
    UI["s"].blit(t, (bx + (w - t.get_width()) // 2, by + 2))
    return hover and UI["click"]


def ui_slider(label, val, lo, hi, w=None, dx=0):
    w = w or UI["w"] - 20
    bx, by = UI["cx"] - UI["x"] + dx, UI["cy"] - UI["y"]
    tr = pygame.Rect(bx, by + 15, w, 6)
    if UI["down"] and tr.move(UI["x"], UI["y"]).inflate(0, 18).move(0, -6).collidepoint(UI["mx"], UI["my"]):
        f = (UI["mx"] - UI["x"] - tr.x - 4) / max(1, tr.w - 8)
        val = lo + max(0.0, min(1.0, f)) * (hi - lo)
    UI["s"].blit(UI_F.render(f"{label}  {val:.1f}", True, (200, 205, 215)), (bx, by))
    pygame.draw.rect(UI["s"], (45, 52, 66), tr, border_radius=3)
    f = (val - lo) / (hi - lo)
    kx = bx + int(f * (tr.w - 8))
    pygame.draw.rect(UI["s"], (110, 165, 255), (tr.x, tr.y, max(4, kx - tr.x + 4), 6), border_radius=3)
    pygame.draw.rect(UI["s"], (235, 240, 250), (kx, tr.y - 2, 8, 10), border_radius=3)
    UI["cy"] += 30
    return val


