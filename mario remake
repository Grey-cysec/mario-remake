def to_canvas(mx, my):
    """Map mouse position from the window into 800x450 canvas space (letterbox-aware)."""
    s = min(WIN_W / W, WIN_H / H)
    return (mx - (WIN_W - W * s) / 2) / s, (my - (WIN_H - H * s) / 2) / s
